{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "public",
  "functions": { "api/[...path].js": { "maxDuration": 10 } },
  "rewrites": [
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/favicon.ico", "destination": "/mascot.png" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "Strict-Transport-Security", "value": "max-age=3600" }
  ] }]
}
