{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts && npm ci --prefix neural-frontier --ignore-scripts --include=dev",
  "outputDirectory": "public",
  "functions": { "api/proxy.js": { "maxDuration": 25 } },
  "rewrites": [
    { "source": "/api/v1/:endpoint", "destination": "/api/proxy?endpoint=:endpoint" },
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/neural-frontier", "destination": "/neural-frontier/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/favicon.ico", "destination": "/mascot.png" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "Strict-Transport-Security", "value": "max-age=3600" }
  ] },
  {"source":"/((?!neural-frontier(?:/|$)).*)","headers":[{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}]},
  {"source":"/neural-frontier/:path*","headers":[{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"}]}]
}
