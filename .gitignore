# Public documentation repository: deny unreviewed additions by default.
*
!/.gitignore
!/README.md
!/docs/
!/docs/README.md
!/docs/features.md
!/docs/architecture.md
!/docs/roadmap.md
!/docs/brand.md
!/docs/project-scope.md
!/.github/
!/.github/CONTRIBUTING.md
!/.github/SECURITY.md

# Defense in depth for Python, secrets and runtime/build artifacts.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.pfx
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.db
*.sqlite
*.sqlite3
*.db-*
*.log
snapshot.json
*.exe
*.dll
*.pyd
*.zip
*.rar
*.7z
*.whl
.DS_Store
Thumbs.db
.idea/
.vscode/

# Approved public frontend and Vercel integration only.
!/.gitattributes
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore
!/approved-frontend.json
!/frontend/
!/frontend/*
!/api/
!/api/*.js
!/lib/
!/lib/*.cjs
!/scripts/
!/scripts/*.cjs
!/tests/
!/tests/*.cjs
/public/
/.vercel/
/node_modules/
